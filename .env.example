# Infrastructure config — needed before the server boots.
# Copy to .env and edit. Everything else is configurable from the UI (Settings).

# API + prod UI port
PORT=3789
# Vite dev-server port (used to build the Origin whitelist)
WEB_PORT=5173

# Pretty local address for the UI — an /etc/hosts alias for 127.0.0.1, set up by
# `sudo npm run setup:host`. Unset means the UI stays on http://127.0.0.1:5173.
# STATION_HOST=claude.station

# Runtime data location. Default: <repo>/data — keeps the install self-contained.
# CLAUDE_STATION_DATA=./data

# Where skills get symlinked so Claude Code loads them at user level.
# This is the only path the app writes outside the repo.
# CLAUDE_SKILLS_DIR=~/.claude/skills

# Fixed API token so it survives restarts and you only type it once.
# Generate with: openssl rand -hex 32
# Without this the server generates one per install into data/.token
# CLAUDE_STATION_TOKEN=

# MCP tool-call timeout (ms) — build commands can be slow.
MCP_TOOL_TIMEOUT=900000

# LOG_LEVEL=info
